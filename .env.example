# BE → AI 호출 키 (BE가 X-API-Key 헤더로 보냄)
AI_API_KEY=change-me

# AI → BE 내부 API
BE_BASE_URL=http://localhost:8080
BE_INTERNAL_KEY=change-me

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-6-luna
OPENAI_MODEL_LIGHT=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 추론 모델일 때만 low / medium / high (비우면 보내지 않음)
OPENAI_REASONING_EFFORT=

# 법령 DB (PostgreSQL + pgvector). 비우면 법령 검색 없이 규칙 엔진만 동작
LAW_DB_URL=postgresql://chagok:chagok@localhost:5432/chagok_law

# 국가법령정보센터 Open API 인증키(OC). 신청할 때 직접 정한 값
LAW_API_OC=
